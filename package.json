{
	"name": "pi-provider-arkcli",
	"version": "0.1.0",
	"private": true,
	"description": "Provider extension for Volcengine ARK (火山方舟): maps GET /api/v3/models onto pi and omp model rows",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"test": "node --test \"test/*.test.ts\"",
		"snapshot": "node scripts/snapshot-ark-models.ts",
		"models": "node scripts/dump-mapped-models.ts",
		"fixture:ocr": "node scripts/make-ocr-fixture.ts",
		"verify:wire": "./scripts/verify-wire.sh",
		"verify:vision": "./scripts/verify-vision.sh",
		"verify:pi-wire": "./scripts/verify-pi-wire.sh"
	},
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"omp": {
		"extensions": ["./src/index.ts"]
	}
}
